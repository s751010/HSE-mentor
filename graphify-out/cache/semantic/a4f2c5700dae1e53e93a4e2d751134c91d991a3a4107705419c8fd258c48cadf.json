{"nodes": [{"id": "marketing_review_critical_review", "label": "Critical Marketing Review of Murshid Platform (June 2026)", "file_type": "document", "source_file": "MARKETING_REVIEW.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "marketing_review_sayyaf_alhothali", "label": "Sayyaf Alhothali (\u0633\u064a\u0627\u0641 \u0627\u0644\u0647\u0630\u0644\u064a, HSE specialist / founder)", "file_type": "concept", "source_file": "MARKETING_REVIEW.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "marketing_review_positioning", "label": "Positioning critique", "file_type": "rationale", "source_file": "MARKETING_REVIEW.md", "source_location": "MARKETING_REVIEW.md:\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Field-credibility positioning is good, but the platform must pick one primary audience (most likely Kawader exam candidates) and aim its entire message at them before expanding."}, {"id": "marketing_review_value_proposition_gap", "label": "Missing sharp value proposition", "file_type": "rationale", "source_file": "MARKETING_REVIEW.md", "source_location": "MARKETING_REVIEW.md:\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generic 'integrated training' messaging should be replaced with a measurable promise such as 'pass the Kawader exam on your first attempt' or 'save 5 hours a week on inspection reports'."}, {"id": "marketing_review_api_key_barrier", "label": "OpenAI API key barrier", "file_type": "rationale", "source_file": "MARKETING_REVIEW.md", "source_location": "MARKETING_REVIEW.md:\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requiring every user to create an OpenAI account and paste a key loses 90%+ of non-technical users \u2014 acceptable for a personal tool, fatal for a mass-market platform."}, {"id": "marketing_review_backend_proxy_solution", "label": "Backend AI proxy recommendation (Supabase/Cloudflare Edge Function)", "file_type": "rationale", "source_file": "MARKETING_REVIEW.md", "source_location": "MARKETING_REVIEW.md:\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ideal fix for the key barrier: an Edge Function holding the founder's key with per-user usage limits, so users never see any key; interim fix is a capped free tier plus fully AI-free features (Kawader, flashcards, matrix) as a conversion bait."}, {"id": "marketing_review_social_proof_gap", "label": "Fabricated testimonials / missing social proof", "file_type": "rationale", "source_file": "MARKETING_REVIEW.md", "source_location": "MARKETING_REVIEW.md:\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Testimonials look invented (names without links or photos); if discovered this damages credibility \u2014 replace with real ones or remove."}, {"id": "marketing_review_personal_branding", "label": "Personal branding strategy", "file_type": "rationale", "source_file": "MARKETING_REVIEW.md", "source_location": "MARKETING_REVIEW.md:\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Founder presence on every page plus direct LinkedIn link builds the personal brand, but needs a real photo, an expanded bio with certifications (NEBOSH/OSHA), and quantified achievements to earn trust."}, {"id": "marketing_review_analytics_gap", "label": "Missing analytics (no visitor measurement)", "file_type": "rationale", "source_file": "MARKETING_REVIEW.md", "source_location": "MARKETING_REVIEW.md:\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No Google Analytics/Plausible means no knowledge of visitor counts, sources, or drop-off \u2014 called the single most important marketing gap ('flying without a compass')."}, {"id": "marketing_review_supabase_sync_plan", "label": "Supabase auth and cross-device sync plan", "file_type": "rationale", "source_file": "MARKETING_REVIEW.md", "source_location": "MARKETING_REVIEW.md:\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "localStorage-only storage is being resolved by connecting Supabase for authentication and cross-device synchronization (listed as in-progress)."}, {"id": "marketing_review_revenue_models", "label": "Revenue model options (Freemium / subscription / B2B / lead generation)", "file_type": "rationale", "source_file": "MARKETING_REVIEW.md", "source_location": "MARKETING_REVIEW.md:\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recommended sequence: start with lead generation (platform as marketing front-end bringing consulting/training opportunities via LinkedIn), then add Freemium once the audience grows; B2B corporate training rated highest value."}, {"id": "marketing_review_competitive_advantage", "label": "Competitive advantage analysis", "file_type": "rationale", "source_file": "MARKETING_REVIEW.md", "source_location": "MARKETING_REVIEW.md:\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Question banks are easily copied by competitors (apps, Telegram/YouTube channels, courses); the durable moat is the personal brand plus user experience, so investment should go there."}, {"id": "marketing_review_action_plan", "label": "Prioritized action plan (quick wins / monthly / quarterly)", "file_type": "concept", "source_file": "MARKETING_REVIEW.md", "source_location": "MARKETING_REVIEW.md:\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "marketing_review_kawader_exam", "label": "Kawader exam (\u0627\u062e\u062a\u0628\u0627\u0631 \u0643\u0648\u0627\u062f\u0631, Saudi HSE certification)", "file_type": "concept", "source_file": "MARKETING_REVIEW.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "marketing_review_critical_review", "target": "murshid_platform", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MARKETING_REVIEW.md", "source_location": "MARKETING_REVIEW.md:1", "weight": 1.0}, {"source": "marketing_review_critical_review", "target": "marketing_review_sayyaf_alhothali", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MARKETING_REVIEW.md", "source_location": "MARKETING_REVIEW.md:2", "weight": 1.0}, {"source": "marketing_review_critical_review", "target": "murshid_kwb", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MARKETING_REVIEW.md", "source_location": "MARKETING_REVIEW.md:\u00a74", "weight": 1.0}, {"source": "marketing_review_value_proposition_gap", "target": "marketing_review_positioning", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MARKETING_REVIEW.md", "source_location": "MARKETING_REVIEW.md:\u00a71", "weight": 1.0}, {"source": "marketing_review_api_key_barrier", "target": "marketing_review_backend_proxy_solution", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MARKETING_REVIEW.md", "source_location": "MARKETING_REVIEW.md:\u00a72", "weight": 1.0}, {"source": "murshid_callai", "target": "marketing_review_backend_proxy_solution", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "MARKETING_REVIEW.md", "source_location": null, "weight": 1.0}, {"source": "murshid_openai_proxy", "target": "marketing_review_backend_proxy_solution", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "MARKETING_REVIEW.md", "source_location": null, "weight"